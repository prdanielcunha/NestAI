{
  "name": "nestai",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "build": "tsc -p tsconfig.json --noEmit && pnpm build:console",
    "verify:branches": "node scripts/verify-branch-sync.mjs",
    "cf:types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "build:console": "pnpm --filter @millionsnest/nestai-console build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4",
    "zod": "^4.1.11",
    "wrangler": "^4.44.0"
  }
}
